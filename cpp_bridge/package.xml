<?xml version="1.0"?>
<package format="3">
  <name>neurolens_bridge</name>
  <version>0.1.0</version>
  <description>C++ bridge connecting NeuroLens object detection to 4-channel haptic vest and speech output.</description>
  <maintainer email="christopher@ncat.edu">Group 7 - Team NeuroLens</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
